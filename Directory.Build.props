<Project>

  <!-- Centrale package-metadata voor alle projecten in deze repository. Een csproj kan deze waarden overschrijven. -->
  <PropertyGroup>
    <Authors>Rob Lohmann</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/roblohmann/CodeCube.API</PackageProjectUrl>
    <RepositoryUrl>https://github.com/roblohmann/CodeCube.API</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>1.2.2</VersionPrefix>
  </PropertyGroup>

</Project>
